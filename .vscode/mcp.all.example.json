{
  // All optional connections together. Keep only the servers you use; never put tokens in this file.
  "servers": {
    "dbsql": { "type": "http", "url": "https://<workspace-host>/api/2.0/mcp/sql",
               "headers": { "Authorization": "Bearer ${input:dbx_token}" } },
    "genie": { "type": "http", "url": "https://<workspace-host>/api/2.0/mcp/genie/<genie_space_id>",
               "headers": { "Authorization": "Bearer ${input:dbx_token}" } },
    "ado":   { "type": "stdio", "command": "npx",
               "args": ["-y", "@azure-devops/mcp", "<your-organisation>", "--authentication", "pat", "-d", "core", "work", "work-items"],
               "env": { "PERSONAL_ACCESS_TOKEN": "${input:ado_pat_b64}" } }
  },
  "inputs": [
    { "id": "dbx_token", "type": "promptString", "password": true, "description": "Databricks token for a READ-ONLY identity" },
    { "id": "ado_pat_b64", "type": "promptString", "password": true, "description": "Base64 of email:PAT (Work Items Read only)" }
  ]
}
